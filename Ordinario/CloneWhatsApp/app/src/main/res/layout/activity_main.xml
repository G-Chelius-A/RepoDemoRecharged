<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/whatsapp_surface_light">

    <!-- Header Verde Superior Estilo WhatsApp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/whatsapp_teal_dark"
        android:elevation="4dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivUserAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_avatar"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="@color/whatsapp_green_accent"
            app:strokeWidth="2dp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWelcomeUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CloneWhatsApp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvUserSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En línea"
                android:textSize="12sp"
                android:textColor="@color/whatsapp_green_accent" />

        </LinearLayout>

        <Button
            android:id="@+id/btnMyProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perfil"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@color/white"
            app:strokeColor="@color/white" />

    </LinearLayout>

    <!-- Botones de Acción Estilizados -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnOpenContacts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NUEVO CHAT"
            android:textStyle="bold"
            app:icon="@drawable/ic_send_24"
            app:iconTint="@color/white"
            android:backgroundTint="@color/whatsapp_teal_light"
            android:textColor="@color/white"
            android:padding="12dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnCreateGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CREAR GRUPO"
            android:textStyle="bold"
            app:icon="@drawable/ic_group_24"
            app:iconTint="@color/white"
            android:backgroundTint="@color/whatsapp_teal_light"
            android:textColor="@color/white"
            android:padding="12dp"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <!-- Card de Destinatario Seleccionado -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSelectedRecipient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:visibility="gone"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Destinatario Seleccionado"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/whatsapp_teal_light"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivRecipientAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_default_avatar"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRecipientName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre Destinatario"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvRecipientId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID: ..."
                        android:textSize="11sp"
                        android:textColor="@color/whatsapp_gray_text" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Sección de Conversaciones Activas -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHATS RECIENTES"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/whatsapp_gray_text"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

    <ProgressBar
        android:id="@+id/progressBarConvos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_margin="16dp" />

    <TextView
        android:id="@+id/tvEmptyConvos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="No tienes chats activos.\n¡Presiona 'NUEVO CHAT' para comenzar!"
        android:textSize="14sp"
        android:textColor="@color/whatsapp_gray_text"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConversations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <Button
        android:id="@+id/btnSignOut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CERRAR SESIÓN"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:textColor="@color/whatsapp_teal_light"
        app:strokeColor="@color/whatsapp_teal_light"
        android:layout_margin="12dp"
        android:padding="10dp" />

</LinearLayout>
