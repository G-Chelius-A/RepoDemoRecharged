<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CloneWhatsApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Paleta de colores principal de WhatsApp -->
        <item name="colorPrimary">@color/whatsapp_teal_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/whatsapp_teal_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/whatsapp_green_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/whatsapp_bubble_sent</item>
        <item name="colorOnSecondaryContainer">#111b21</item>

        <item name="android:statusBarColor">@color/whatsapp_teal_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.CloneWhatsApp" parent="Base.Theme.CloneWhatsApp" />
</resources>
