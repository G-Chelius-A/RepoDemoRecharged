<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lobby_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#1C1C1E"
    tools:context=".LobbyActivity">

    <!-- Header User Session & Signout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOBBY MULTIJUGADOR"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tv_user_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sesión activa"
                android:textColor="#8E8E93"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salir"
            android:textColor="#FF3B30" />
    </LinearLayout>

    <!-- Main Create Game Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create_game"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="➕  CREAR NUEVA SALA DE JUEGO"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#007AFF"
        app:cornerRadius="14dp"
        android:layout_marginBottom="20dp" />

    <!-- Waiting Games Header & Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Salas Abiertas en Vivo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#E5E5EA" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh_lobby"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Actualizar"
            android:textColor="#007AFF" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_lobby_games"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/item_game_lobby" />

        <TextView
            android:id="@+id/tv_empty_lobby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No hay salas públicas esperando. ¡Crea la primera!"
            android:textColor="#8E8E93"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Action Back to Menu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back_menu"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Volver al Menú Principal"
        android:textColor="#8E8E93"
        app:strokeColor="#3A3A3C"
        app:cornerRadius="12dp"
        android:layout_marginTop="12dp" />

</LinearLayout>
