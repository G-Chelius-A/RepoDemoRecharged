<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/online_game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1E"
    tools:context=".OnlineGameActivity">

    <!-- Top Card: Oponente -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_player_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#2C2C2E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_top_player_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oponente (En Línea)"
                    android:textColor="#E5E5EA"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_top_captured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#8E8E93"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_top_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1C1C1E"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="10:00"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Header Estado / Puntaje Multijugador -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tv_online_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sincronizando con Supabase..."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_online_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puntaje: *"
            android:textColor="#007AFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tablero de Ajedrez Interactivo -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <com.example.cheliuschess.ui.ChessBoardView
            android:id="@+id/chess_board_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Strip Notación SAN -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:scrollbars="none"
        android:background="#222224">

        <TextView
            android:id="@+id/tv_moves_san"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAN: -"
            android:textColor="#E5E5EA"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </HorizontalScrollView>

    <!-- Bottom Card: Jugador Local -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_player_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#2C2C2E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bottom_player_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tú (En Línea)"
                    android:textColor="#E5E5EA"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_bottom_captured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#8E8E93"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_bottom_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1C1C1E"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="10:00"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Barra de Herramientas de Control en Línea -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:background="#2C2C2E">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_resign"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Rendirse"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exit_game"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:contentDescription="Volver al Lobby"
            app:icon="@android:drawable/ic_menu_close_clear_cancel"
            app:iconSize="24dp" />
    </LinearLayout>

</LinearLayout>
